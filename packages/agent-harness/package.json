{
	"name": "@cyberuni/agent-harness",
	"version": "0.5.0",
	"description": "A toolkit for working with AI agent harnesses: detect which one is running, query its managed-policy locations, plugin storage, enabled plugins, and skill naming, and resolve layered reference documents.",
	"keywords": [
		"agent-harness",
		"claude-code",
		"cursor",
		"codex",
		"copilot-cli",
		"opencode",
		"kilo-code",
		"gemini-cli",
		"qwen-code",
		"vscode",
		"cline",
		"crush",
		"openhands",
		"auggie"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyberuni/agent-harness.git",
		"directory": "packages/agent-harness"
	},
	"license": "MIT",
	"author": "unional <homawong@gmail.com>",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./commands": "./dist/commands.js",
		"./worktrees": "./dist/worktrees.js",
		"./package.json": "./package.json"
	},
	"bin": {
		"agent-harness": "./bin/agent-harness.mjs"
	},
	"files": [
		"LICENSE",
		"bin",
		"dist",
		"skills",
		"plugin.json",
		".claude-plugin",
		".cursor-plugin",
		".codex-plugin"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsx src/index.ts",
		"lint": "biome check .",
		"prepack": "pnpm build",
		"test": "pnpm build && vitest run src",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"verify": "pnpm typecheck && pnpm lint && pnpm test"
	},
	"dependencies": {
		"@toon-format/toon": "^4.1.1",
		"clibuilder": "^11.3.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/node": "^24.10.1",
		"tsdown": "^0.23.0",
		"tsx": "^4.22.3",
		"typescript": "^7.0.0",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
