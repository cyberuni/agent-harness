{
	"name": "@cyberuni/agent-harness",
	"version": "0.0.0",
	"description": "Detect which AI agent harness is running and query its managed-policy locations, plugin storage, enabled plugins, and skill naming.",
	"keywords": [
		"agent-harness",
		"claude-code",
		"cursor",
		"codex",
		"copilot-cli",
		"opencode",
		"kilo-code",
		"gemini-cli",
		"qwen-code",
		"vscode",
		"cline"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyberuni/agent-harness.git",
		"directory": "packages/agent-harness"
	},
	"license": "MIT",
	"author": "unional <homawong@gmail.com>",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"files": [
		"LICENSE",
		"dist",
		"plugin.json",
		".claude-plugin",
		".cursor-plugin",
		".codex-plugin",
		"com.github.copilot"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsx src/index.ts",
		"lint": "biome check .",
		"prepack": "pnpm build",
		"test": "pnpm build && vitest run src",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"verify": "pnpm typecheck && pnpm lint && pnpm test"
	},
	"devDependencies": {
		"@types/node": "^24.10.1",
		"tsdown": "^0.23.0",
		"tsx": "^4.22.3",
		"typescript": "^6.0.0",
		"vitest": "^4.1.7"
	},
	"packageManager": "pnpm@11.28.0",
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
