# The reference skill's launcher, bundled by `pnpm build` (packages/agent-harness/tsdown.config.ts).
# It ships through the npm package's `files`, not through git; a git-sourced install falls back to
# the pinned `npx` invocation the skill's SKILL.md documents.
packages/agent-harness/skills/*/scripts/*.mjs
