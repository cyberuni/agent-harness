{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"check": "biome check --write",
		"cs": "changeset",
		"dev": "pnpm --filter @cyberuni/agent-harness dev",
		"format": "biome format --write .",
		"prepare": "node -e \"if(!(process.env.CI||process.env.GITHUB_ACTIONS))require('child_process').execSync('husky',{stdio:'inherit'})\"",
		"release": "changeset publish",
		"test": "turbo test",
		"test:scripts": "node --test \"scripts/**/*.test.mjs\"",
		"typecheck": "turbo typecheck",
		"plugin:sync": "universal-plugin publish sync-version --root packages/agent-harness && node packages/agent-harness/scripts/sync-skill-pin.mjs && universal-plugin plugin build --root packages/agent-harness && biome format --write packages/agent-harness",
		"up": "pnpm --filter ./packages/agent-harness",
		"verify": "turbo verify",
		"version": "changeset version && pnpm plugin:sync",
		"web": "pnpm --filter web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"turbo": "^2.9.16",
		"universal-plugin": "^0.12.0"
	},
	"packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
	"engines": {
		"node": ">=22"
	}
}
