{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"check": "biome check --write",
		"cs": "changeset",
		"dev": "pnpm --filter @cyberuni/agent-harness dev",
		"format": "biome format --write .",
		"prepare": "node -e \"if(!(process.env.CI||process.env.GITHUB_ACTIONS))require('child_process').execSync('husky',{stdio:'inherit'})\"",
		"release": "changeset publish",
		"test": "turbo test",
		"test:scripts": "node --test \"scripts/**/*.test.mjs\"",
		"typecheck": "turbo typecheck",
		"plugin:sync": "universal-plugin publish sync-version --root packages/agent-harness && universal-plugin plugin build --root packages/agent-harness && biome format --write packages/agent-harness",
		"up": "pnpm --filter ./packages/agent-harness",
		"verify": "turbo verify",
		"version": "changeset version && pnpm plugin:sync",
		"web": "pnpm --filter web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"turbo": "^2.9.16",
		"universal-plugin": "^0.11.0"
	},
	"packageManager": "pnpm@12.9.0+sha512.8f64efa0b792986ca98ae568791bcd7722807e274c4f0c1d9853c62116495c584119db98762a2a5343b1684d361b9ae26fdd16d551666d7635346d3fae830ddd",
	"engines": {
		"node": ">=22"
	}
}
