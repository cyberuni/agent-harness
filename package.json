{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"check": "biome check --write",
		"cs": "changeset",
		"dev": "pnpm --filter @cyberuni/agent-harness dev",
		"format": "biome format --write .",
		"prepare": "node -e \"if(!(process.env.CI||process.env.GITHUB_ACTIONS))require('child_process').execSync('husky',{stdio:'inherit'})\"",
		"release": "changeset publish",
		"test": "turbo test",
		"test:scripts": "node --test \"scripts/**/*.test.mjs\"",
		"typecheck": "turbo typecheck",
		"plugin:sync": "universal-plugin publish sync-version --root packages/agent-harness && node packages/agent-harness/scripts/sync-skill-pin.mjs && universal-plugin plugin build --root packages/agent-harness && biome format --write packages/agent-harness",
		"up": "pnpm --filter ./packages/agent-harness",
		"verify": "turbo verify",
		"version": "changeset version && pnpm plugin:sync",
		"web": "pnpm --filter web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"turbo": "^2.9.16",
		"universal-plugin": "^0.11.0"
	},
	"packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
	"engines": {
		"node": ">=22"
	}
}
