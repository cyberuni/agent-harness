{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"//#check": {
			"cache": false,
			"outputs": []
		},
		"build": {
			"outputs": ["dist/**", "skills/*/scripts/*.mjs"],
			"dependsOn": ["^build"]
		},
		"check": {
			"dependsOn": ["//#check"]
		},
		"typecheck": {
			"dependsOn": ["build"]
		},
		"lint": {},
		"test": {
			"dependsOn": ["build"]
		},
		"verify": {
			"dependsOn": ["check", "build", "typecheck", "lint", "test", "//#test:scripts"]
		},
		"//#test:scripts": {
			"inputs": [
				"scripts/**",
				"packages/agent-harness/src/harness/**",
				"packages/agent-harness/src/skills/**",
				".research/harness-detection/evidence.md"
			],
			"outputs": []
		}
	}
}
